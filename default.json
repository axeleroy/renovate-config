{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeStableNonMajor",
    ":automergeDigest",
    ":labels(dependencies)"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  }
}

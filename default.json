{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeStableNonMajor",
    ":automergeDigest",
    ":labels(dependencies)",
    "group:pnpm",
    "group:nodeJs",
    "group:eslintMonorepo",
    "group:typescript-eslintMonorepo"
  ],
  "ignorePresets": [
    "security:minimumReleaseAgeNpm"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  },
  "statusCheckWhen": {
    "artifactError": "always"
  },
  "internalChecksAsSuccess": true,
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "packageRules": [
    {
      "description": "Ensure any digest-pinned, GitHub-sourced, dependencies creates a link to the diff between the two commits",
      "matchSourceUrls": [
        "https://github.com/**/*"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "changelogUrl": "{{sourceUrl}}/compare/{{currentDigest}}..{{newDigest}}"
    },
    {
      "description": "Group Node.js updates across managers",
      "commitMessageTopic": "Node.js",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "mise"
      ],
      "matchPackageNames": [
        "/node/"
      ]
    },
    {
      "matchUpdateTypes": ["digest", "pinDigest", "lockFileMaintenance"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Disable updates for forgejo forks of @actions/artifacts",
      "matchPackageNames": [
        "https://data.forgejo.org/forgejo/upload-artifact",
        "https://data.forgejo.org/forgejo/download-artifact"
      ],
      "matchManagers": [
        "ci"
      ],
      "enabled": false
    }
  ]
}
